# USINA IPIRANGA · Ambiente do backend (somente no servidor)
# Não publique este arquivo com valores reais. Configure como secrets na hospedagem.
MONGO_URL=mongodb://localhost:27017/ipiranga
DB_NAME=ipiranga
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# Senha >= 12 caracteres exigida apenas na criação inicial. Remover após uso.
INITIAL_ADMIN_PASSWORD=

# Gateway de leitura apenas. Chave aleatória >= 32 caracteres; NÃO usar no navegador.
INDUSTRIAL_GATEWAY_KEY=

# Serviço de IA EXTERNO. Compartilhamento de dados industriais exige aprovação da usina.
AI_EXTERNAL_SHARING_APPROVED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
